# --- Network ---
RPC_URL=http://127.0.0.1:5050
CHAIN_ID=SN_SEPOLIA

# --- Agent identity (SECRETS — never commit a real .env) ---
# The scoped session key signs; the account address is policy.agent on-chain.
AGENT_SESSION_PRIVATE_KEY=0x...
AGENT_ACCOUNT_ADDRESS=0x...

# --- Deployed contracts (from docs/DEPLOYMENTS.md / deploy output) ---
REGISTRY_ADDRESS=0x...
VAULT_ADDRESS=0x...
EXECUTOR_ADDRESS=0x...

# --- Off-chain payroll + local state ---
PAYROLL_CONFIG_PATH=./payroll.json
DB_PATH=./data/agent.sqlite

# --- Behaviour ---
POLL_INTERVAL_MS=60000
LOG_LEVEL=info
# DRY_RUN=true simulates every cycle but never submits.
DRY_RUN=false

# --- Optional: post-hoc LLM cycle summary (NOT in the execution path) ---
# CLAUDE_API_KEY=sk-ant-...

# --- Optional: notifications ---
# WEBHOOK_URL=https://...
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_CHAT_ID=...
