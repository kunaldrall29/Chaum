{
  "name": "@chaum/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chaum autonomous disbursement agent — deterministic cycle engine, no LLM in the hot path",
  "license": "MIT",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./crypto": "./src/commitments.ts",
    "./merkle": "./src/merkle.ts",
    "./streams": "./src/streams.ts",
    "./jitter": "./src/jitter.ts",
    "./anomaly": "./src/anomaly.ts",
    "./packets": "./src/packets.ts",
    "./engine": "./src/engine.ts",
    "./payroll": "./src/payroll.ts",
    "./chain": "./src/chain.ts",
    "./config": "./src/config.ts"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "test": "tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@scure/starknet": "^2.2.0",
    "starknet": "^10.0.2",
    "better-sqlite3": "^12.11.1",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2"
  }
}
