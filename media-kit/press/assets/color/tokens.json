{
  "name": "Chaum brand tokens",
  "version": "1.0.0",
  "color": {
    "vault": {
      "hex": "#0C0F14",
      "rgb": "12, 15, 20",
      "usage": "ground"
    },
    "paper": {
      "hex": "#ECE7DD",
      "rgb": "236, 231, 221",
      "usage": "voice"
    },
    "seal": {
      "hex": "#8C2F23",
      "rgb": "140, 47, 35",
      "usage": "the accent — wax on a document, ≤5 uses per view, never an error color"
    },
    "disclosed": {
      "hex": "#3FA66A",
      "rgb": "63, 166, 106",
      "usage": "only revealed / proven states"
    },
    "warning": {
      "hex": "#C9892F",
      "rgb": "201, 137, 47",
      "usage": "caution states"
    },
    "danger": {
      "hex": "#B23B3B",
      "rgb": "178, 59, 59",
      "usage": "failures only"
    },
    "graphite": {
      "hex": "#1A1E26",
      "rgb": "26, 30, 38",
      "usage": "redactions / panels"
    }
  },
  "type": {
    "display": {
      "family": "Fraunces",
      "role": "display / headlines",
      "weights": [
        500,
        600
      ],
      "opticalSize": "9..144",
      "fallback": "Georgia, 'Times New Roman', serif"
    },
    "body": {
      "family": "Hanken Grotesk",
      "role": "body / UI",
      "weights": [
        400,
        500,
        600
      ],
      "fallback": "system-ui, -apple-system, 'Segoe UI', sans-serif"
    },
    "mono": {
      "family": "Spline Sans Mono",
      "role": "figures / addresses / proofs",
      "weights": [
        400,
        500
      ],
      "fallback": "ui-monospace, 'SF Mono', Menlo, Consolas, monospace"
    }
  },
  "rules": {
    "sealUses": "≤ 5 per view",
    "sealAndDisclosed": "never adjacent at equal weight",
    "money": "all money is mono",
    "category": "confidential operating account — never 'privacy coin', 'mixer', or 'anonymous payroll'"
  }
}
